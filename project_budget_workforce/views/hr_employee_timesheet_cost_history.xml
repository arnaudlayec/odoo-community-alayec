<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Action & menu: view cost history from accounting budget -->
    <record id="account_move_budget_workforce_act_window" model="ir.actions.act_window">
        <field name="name">Cost History</field>
        <field name="res_model">hr.employee.timesheet.cost.history</field>
        <field name="view_mode">tree</field>
        <field name="context">{
            'display_analytic': True,
            'search_default_filter_analytic': 1,
            'search_default_filter_current': 1,
        }</field>
    </record>
    <menuitem id="account_move_budget_workforce_menu"
        action="account_move_budget_workforce_act_window"
        parent="project_budget.account_move_budget_section"
    />

    <!-- Tree view, only in Accounting app, add:
        - Date To
        - Analytic Account
        - button to Department or Employee
    -->
    <record id="hr_employee_timesheet_cost_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.timesheet.cost.history.view.tree</field>
        <field name="model">hr.employee.timesheet.cost.history</field>
        <field name="inherit_id" ref="hr_employee_cost_history.hr_employee_timesheet_cost_view_tree" />
        
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="action">button_open_details</attribute>
                <attribute name="type">object</attribute>
                <attribute name="editable">bottom</attribute>
                <attribute name="editable">bottom</attribute>
            </tree>

            <field name="hourly_cost" position="before">
                <field name="analytic_account_id"
                    options="{'no_create_edit': 1}"
                    invisible="not context.get('display_analytic')"
                    attrs="{'readonly': [('analytic_account_id', '=', False), ('id', '!=', False)]}"
                />
            </field>

            <field name="starting_date" position="after">
                <field name="date_to" />
            </field>

            <!-- Protect modification of fields when not on analytic line -->
            <field name="hourly_cost" position="attributes">
                <attribute name="attrs">{'readonly': [('analytic_account_id', '=', False)]}</attribute>
            </field>
            <field name="starting_date" position="attributes">
                <attribute name="attrs">{'readonly': [('analytic_account_id', '=', False)]}</attribute>
            </field>
        </field>
    </record>

    <!-- Search -->
    <record model="ir.ui.view" id="hr_employee_timesheet_cost_search">
        <field name="name">hr.employee.timesheet.cost.history.view.search.budget_workforce</field>
        <field name="model">hr.employee.timesheet.cost.history</field>
        <field name="inherit_id" ref="hr_department_cost_history.hr_employee_timesheet_cost_search" />

        <field name="arch" type="xml">
            <xpath expr="//field[last()]" position="after">
                <field name="analytic_account_id" />
            </xpath>
            
            <xpath expr="//filter[last()]" position="after">
                <filter name="filter_analytic" string="Analytic account" domain="[('analytic_account_id', '!=', False)]" />

                <separator name="filter_date" />
                <filter
                    name="filter_current"
                    string="Current"
                    domain="[
                    '|',
                        ('starting_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                        ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d')),
                    ]"
                />
                <filter name="starting_date" string="Date from" date="starting_date" />
                <filter name="date_to" string="Date to" date="date_to" />
            </xpath>

            <group position="inside">
                <filter name="date_to" string="Date from" context="{'group_by': 'date_to:year'}"/>
            </group>
        </field>
    </record>

</odoo>
