<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Skip `hr_timesheet` rules enforcing `project_id` for mrp_workcenter analytic lines -->
        <record id="mrp_analytic_category" model="ir.rule">
            <field name="name">account.analytic.line.mrp</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[('category', '=', 'manufacturing_order')]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>
    </data>

</odoo>
