<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_timesheet_cost_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.timesheet.cost.history.view.tree</field>
        <field name="model">hr.employee.timesheet.cost.history</field>
        <field name="inherit_id" ref="hr_employee_cost_history.hr_employee_timesheet_cost_view_tree" />
        
        <field name="arch" type="xml">
            <field name="hourly_cost" position="before">
                <field name="workcenter_id" optional="show" />
            </field>
        </field>
    </record>

    <!-- Search -->
    <record model="ir.ui.view" id="hr_employee_timesheet_cost_search">
        <field name="name">hr.employee.timesheet.cost.history.view.search.mrp</field>
        <field name="model">hr.employee.timesheet.cost.history</field>
        <field name="inherit_id" ref="hr_department_cost_history.hr_employee_timesheet_cost_search" />

        <field name="arch" type="xml">
            <xpath expr="//field[last()]" position="after">
                <field name="workcenter_id" />
            </xpath>

            <xpath expr="//filter[last()]" position="after">
                <filter name="filter_workcenter" string="Workcenters" domain="[('workcenter_id', '!=', False)]" />
            </xpath>
        </field>
    </record>
    
</odoo>
