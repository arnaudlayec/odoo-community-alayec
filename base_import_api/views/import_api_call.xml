<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="base_import_api_call_list" model="ir.ui.view">
        <field name="name">import.api.call.list</field>
        <field name="model">import.api.call</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_description" />
                <field name="create_date" decoration-bf="1" />
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <field name="create_uid" widget="res_partner_many2one" optional="hide" />
                <field name="line_count" />
                <field name="record_count" />
                <field name="state"
                    widget="badge"
                    decoration-success="state in ['success', 'verified']"
                    decoration-info="state == 'info'"
                    decoration-warning="state == 'warning'"
                    decoration-danger="state == 'error'"
                />
            </list>
        </field>
    </record>

    <record id="base_import_api_call_form" model="ir.ui.view">
        <field name="name">import.api.call.form</field>
        <field name="model">import.api.call</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_replay"
                        string="Replay import"
                        type="object"
                        class="oe_highlight"
                        icon="fa-refresh"
                    />
                    <button name="action_toggle_verified_all"
                        string="Mark as all verified"
                        type="object"
                        class="btn btn-success"
                        invisible="line_count == 0 or state in ['verified', 'success']"
                        icon="fa-check"
                    />
                    <button name="action_toggle_verified_all"
                        string="Mark as all unverified"
                        type="object"
                        class="btn btn-warning"
                        invisible="line_count == 0 or state in ['info', 'warning', 'error']"
                        icon="fa-times"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_records"
                            icon="fa-download"
                            invisible="record_count == 0"
                        >
                            <div class="o_stat_info">
                                <field name="record_count" class="o_stat_value" />
                                <span class="o_stat_text">
                                    <field name="model_description" />
                                </span>
                            </div>
                        </button>

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_lines"
                            icon="fa-list"
                            invisible="line_count == 0"
                        >
                            <field name="line_count" widget="statinfo"/>
                        </button>

                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_lines"
                            context="{'previous_line': True}"
                            icon="fa-list"
                            invisible="previous_line_count == 0"
                        >
                            <field name="previous_line_count" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                        </h1>
                    </div>
                    
                    <group name="main">
                        <group name="main_left">
                            <label for="model" groups="base_import_api.group_import_api_manager"/>
                            <div name="model" groups="base_import_api.group_import_api_manager">
                                <field name="model" class="oe_inline" />
                                <span name="model_description" class="mx-3">
                                    <field name="model_description" class="oe_inline" />
                                </span>
                            </div>
                            
                            <field name="create_date" decoration-bf="1" />
                            <field name="create_uid" widget="res_partner_many2one" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group name="main_right">
                            <label for="state" />
                            <div name="state">
                                <field name="state"
                                    widget="badge"
                                    decoration-success="state in ['success', 'verified']"
                                    decoration-info="state == 'info'"
                                    decoration-warning="state == 'warning'"
                                    decoration-danger="state == 'error'"
                                />
                                <field name="state_text" nolabel="1" />
                            </div>
                        </group>
                    </group>
                    
                    <notebook name="lines">
                        <page name="report" string="Last report">
                            <em>This content is dynamic. It is generated from log lines.</em>
                            <field
                                name="report"
                                widget="html"
                                nolabel="1" colspan="2"
                                class="mt-3"
                            />
                        </page>
                        <page name="payload" string="Payload" groups="base_import_api.group_import_api_manager">
                            <group name="payload" col="12">
                                <group name="payload_left" colspan="4">
                                    <label for="config" />
                                    <field
                                        name="config"
                                        widget="code"
                                        options="{'mode': 'python'}"
                                        nolabel="1" colspan="2"
                                    />
                                </group>
                                <group name="payload_right" colspan="8">
                                    <label for="data" />
                                    <field
                                        name="data"
                                        widget="code"
                                        options="{'mode': 'python'}"
                                        nolabel="1" colspan="2"
                                    />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="base_import_api_call_search" model="ir.ui.view">
        <field name="name">import.api.call.search</field>
        <field name="model">import.api.call</field>
        <field name="arch" type="xml">
            <search>
                <field name="model" />
                <field name="create_date" />
                <field name="create_uid" />
                <field name="config" />
                <field name="data" />

                <separator />
                <filter
                    name="state_success"
                    domain="[('state', '=', 'success')]"
                    string="Success"
                />
                <filter
                    name="state_verified"
                    domain="[('state', '=', 'verified')]"
                    string="Verified"
                />
                <filter
                    name="state_info"
                    domain="[('state', '=', 'info')]"
                    string="Needing user review"
                />
                <filter
                    name="state_warning"
                    domain="[('state', '=', 'warning')]"
                    string="Warning (some lines failed)"
                />
                <filter
                    name="state_error"
                    domain="[('state', '=', 'error')]"
                    string="Error (blocking failure)"
                />
                <separator />
                <filter
                    string="Import date"
                    name="date_last_call"
                    date="date_last_call"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />

                <group name="groupby">
                    <filter
                        name="logger_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="create_date"
                        string="Creation date"
                        context="{'group_by': 'create_date'}"
                    />
                    <filter
                        name="create_uid"
                        string="Creation user"
                        context="{'group_by': 'create_uid'}"
                    />
                    <filter
                        name="model"
                        string="Model"
                        context="{'group_by': 'model'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Actions for menu-items -->
    <record
        model="ir.actions.act_window"
        id="import_api_call_action"
    >
        <field name="name">API call</field>
        <field name="res_model">import.api.call</field>
        <field name="view_mode">list,form</field>
    </record>
    <record
        model="ir.actions.act_window"
        id="import_api_line_action"
    >
        <field name="name">API call line</field>
        <field name="res_model">import.api.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items, from top -->
    <menuitem
        id="import_api_menu"
        name="API Imports"
        groups="base_import_api.group_import_api_user"
        sequence="90"
        web_icon="base_import_api,static/description/icon.png"
    >
        <menuitem
            id="import_api_base_menu"
            name="Imports"
            sequence="10"
        >
            <menuitem
                id="import_api_call_menu"
                action="base_import_api.import_api_call_action"
                sequence="10"
                />
            <menuitem
                id="import_api_call_line_menu"
                action="base_import_api.import_api_line_action"
                sequence="20"
            />
        </menuitem>
    </menuitem>

</odoo>
