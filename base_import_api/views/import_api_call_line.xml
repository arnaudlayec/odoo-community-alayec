<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="base_import_api_call_line_list" model="ir.ui.view">
        <field name="name">import.api.line.list</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="logger_id" decoration-bf="1" />
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <field name="external_id" decoration-bf="1" />
                <field name="record_ref" optional="show" />
                <field name="message" optional="show" />
                <field name="create_date" optional="show" />
                <field name="create_uid" optional="show" />
                <field name="field" optional="show" />
                <field name="value" optional="show" />
                <field name="state"
                    optional="show"
                    widget="badge"
                    decoration-success="state == 'success'"
                    decoration-info="state == 'info'"
                    decoration-danger="state == 'error'"
                />
            </list>
        </field>
    </record>

    <record id="base_import_api_call_line_form" model="ir.ui.view">
        <field name="name">import.api.line.form</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box" />

                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                            <field name="logger_id" />
                        </h1>
                    </div>
                    
                    <group name="main">
                        <group name="main_left">
                            <field name="external_id" decoration-bf="1" />
                            <field name="record_ref" decoration-bf="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group name="main_right">
                            <field name="field" />
                            <field name="value" />
                        </group>
                    </group>

                    <group name="message">
                        <label for="message" />
                        <field name="message" nolabel="1" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_import_api_call_line_search" model="ir.ui.view">
        <field name="name">import.api.line.search</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_id" />
                <field name="model" />
                <field name="field" />
                <field name="message" />
                <field name="create_date" />
                <field name="create_uid" />

                <separator />
                <filter
                    name="state_success"
                    domain="[('state', '=', 'success')]"
                    string="Success"
                />
                <filter
                    name="state_info"
                    domain="[('state', '=', 'info')]"
                    string="Needing review"
                />
                <filter
                    name="state_error"
                    domain="[('state', '=', 'error')]"
                    string="Not imported"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />

                <group name="groupby">
                    <filter
                        name="api_call"
                        string="API call"
                        context="{'group_by': 'logger_id'}"
                    />
                    <filter
                        name="logger_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="create_date"
                        string="Creation date"
                        context="{'group_by': 'create_date'}"
                    />
                    <filter
                        name="create_uid"
                        string="Creation user"
                        context="{'group_by': 'create_uid'}"
                    />
                    <filter
                        name="model"
                        string="Model"
                        context="{'group_by': 'model'}"
                    />
                </group>
            </search>
        </field>
    </record>

</odoo>
