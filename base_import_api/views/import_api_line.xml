<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="base_import_api_call_line_list" model="ir.ui.view">
        <field name="name">import.api.line.list</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <list action="action_open_record_ref" type="object"
                create="False" import="False" open_form_view="True"
            >
                <header>
                    <button type="object" name="action_toggle_verified" string="Verified / Unverify"/>
                </header>
                
                <field name="logger_id"
                    decoration-bf="1"
                    options="{'no_create': True}"
                    column_invisible="context.get('default_logger_id')"
                />
                <field name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    column_invisible="context.get('default_logger_id')"
                />
                <field name="create_date" optional="hide" />
                <field name="create_uid" optional="hide" />
                <field name="model_description" decoration-bf="1" />
                <field name="external_ref" decoration-bf="1" />
                <field name="record_ref" optional="show" />
                <field name="message" optional="show" />
                <field name="field" optional="hide" />
                <field name="value" optional="hide" />
                <field name="state"
                    optional="show"
                    widget="badge"
                    decoration-success="state == 'success'"
                    decoration-info="state == 'info'"
                    decoration-warning="state == 'warning'"
                    decoration-danger="state in ['error', 'global']"
                />
                <field name="verified" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="base_import_api_call_line_form" model="ir.ui.view">
        <field name="name">import.api.line.form</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box" />

                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title mb-3">
                        <h1>
                            <field name="logger_id" />
                        </h1>
                    </div>
                    
                    <group name="main">
                        <group name="main_left">
                            <field name="external_ref" decoration-bf="1" />
                            <field name="record_ref" decoration-bf="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group name="main_right">
                            <field name="field" />
                            <field name="value" />
                            <field name="verified" widget="boolean_toggle" />
                        </group>
                    </group>

                    <group name="message" string="Message">
                        <field name="message" nolabel="1" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_import_api_call_line_search" model="ir.ui.view">
        <field name="name">import.api.line.search</field>
        <field name="model">import.api.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="message" />
                <field name="external_ref" />
                <field name="model" />
                <field name="field" />
                <field name="create_date" />
                <field name="create_uid" />

                <separator />
                <filter
                    name="state_success"
                    domain="[('state', '=', 'success')]"
                    string="Success"
                />
                <filter
                    name="state_info"
                    domain="[('state', '=', 'info')]"
                    string="Information"
                />
                <filter
                    name="state_warning"
                    domain="[('state', '=', 'warning')]"
                    string="With defect"
                />
                <filter
                    name="state_error"
                    domain="[('state', '=', 'error')]"
                    string="Not imported"
                />
                <separator />
                <filter
                    string="Verified"
                    name="verified"
                    domain="[('verified', '=', True)]"
                />
                <filter
                    string="Unverified"
                    name="unverified"
                    domain="[('verified', '=', False)]"
                />
                <separator />
                <filter
                    string="Import date"
                    name="create_date"
                    date="create_date"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />

                <group name="groupby">
                    <filter
                        name="api_call"
                        string="API call"
                        context="{'group_by': 'logger_id'}"
                    />
                    <filter
                        name="logger_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="create_date"
                        string="Creation date"
                        context="{'group_by': 'create_date'}"
                    />
                    <filter
                        name="create_uid"
                        string="Creation user"
                        context="{'group_by': 'create_uid'}"
                    />
                    <filter
                        name="model"
                        string="Model"
                        context="{'group_by': 'model'}"
                    />
                </group>
            </search>
        </field>
    </record>


    <!-- Action called from tree view -->
    <record model="ir.actions.server" id="action_server_toggle_verified">
        <field name="name">Verified / Unverify</field>
        <field name="model_id" ref="base_import_api.model_import_api_line"/>
        <field name="state">code</field>
        <field name="code">model.action_toggle_verified()</field>
        <field name="binding_model_id" ref="model_import_api_line" />
        <field name="binding_type">action</field>
    </record>

</odoo>
