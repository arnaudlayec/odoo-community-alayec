<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import banner -->
    <template id="import_api_banner">
        <div>
            <div name="import_api_banner" role="alert" class="alert alert-info"
                invisible="not id or not external_ref"
            >
                Record created or updated by an external source (API).
                External ID: <field name="external_ref" class="fw-bold" />.

                Import date on <field name="create_date" class="fw-bold" />
                by <field name="create_uid" class="fw-bold" />.
                
                <div t-if="write_uid">
                    Last update on <field name="write_date" class="fw-bold" />
                    by <field name="write_uid" class="fw-bold" />.
                </div>
            </div>
        </div>
    </template>

</odoo>
